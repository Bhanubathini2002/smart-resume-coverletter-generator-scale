# copy to .env and fill in — any OpenAI-compatible chat endpoint works
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini

# optional
# LLM_WORKERS=4          # parallel jobs
# RESUME_PAGES=1         # page target for the resume (cover letter is always 1)
# LATEX_BIN=C:/Users/you/AppData/Local/Programs/MiKTeX/miktex/bin/x64   # only if pdflatex is not on PATH
